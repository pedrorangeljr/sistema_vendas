<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1>Produtos</h1>
    <p class="text-muted mb-0">
      Gerenciamento de produtos e estoque
    </p>
  </div>
  <%= link_to "Novo Produto",
              new_product_path,
              class: "btn btn-primary" %>
</div>
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <%= form_with url: products_path,
                  method: :get,
                  local: true do |form| %>
      <div class="row g-2">
        <div class="col-md-6">
          <%= form.text_field :search,
                              value: params[:search],
                              class: "form-control",
                              placeholder: "Nome ou SKU..." %>
        </div>
        <div class="col-md-4">
          <%= form.collection_select :category_id,
                                     @categories,
                                     :id,
                                     :name,
                                     { prompt: "Todas as categorias",
                                       selected: params[:category_id] },
                                     { class: "form-select" } %>
        </div>
        <div class="col-md-2">
          <%= form.submit "Pesquisar",
                          class: "btn btn-outline-primary w-100" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
<div class="card shadow-sm">
  <div class="card-body">
    <% if @products.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th>Produto</th>
              <th>SKU</th>
              <th>Categoria</th>
              <th>Preço</th>
              <th>Estoque</th>
              <th>Status</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @products.each do |product| %>
              <tr>
                <td>
                  <strong>
                    <%= product.name %>
                  </strong>
                </td>
                <td>
                  <%= product.sku %>
                </td>
                <td>
                  <%= product.category.name %>
                </td>
                <td>
                  R$ <%= number_with_precision(
                    product.price,
                    precision: 2
                  ) %>
                </td>
                <td>
                  <% if product.stock_quantity <= product.minimum_stock %>
                    <span class="badge text-bg-warning">
                      <%= product.stock_quantity %>
                    </span>
                  <% else %>
                    <span class="badge text-bg-success">
                      <%= product.stock_quantity %>
                    </span>
                  <% end %>
                </td>
                <td>
                  <% if product.active? %>
                    <span class="badge text-bg-success">
                      Ativo
                    </span>
                  <% else %>
                    <span class="badge text-bg-secondary">
                      Inativo
                    </span>
                  <% end %>
                </td>
                <td class="text-end">
                  <%= link_to "Visualizar",
                              product_path(product),
                              class: "btn btn-sm btn-outline-primary" %>
                  <%= link_to "Editar",
                              edit_product_path(product),
                              class: "btn btn-sm btn-outline-secondary" %>
                  <%= link_to "Excluir",
                              product_path(product),
                              data: {
                                turbo_method: :delete,
                                turbo_confirm: "Deseja realmente excluir este produto?"
                              },
                              class: "btn btn-sm btn-outline-danger" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <h4>Nenhum produto encontrado</h4>
        <p class="text-muted">
          Cadastre o primeiro produto.
        </p>
        <%= link_to "Novo Produto",
                    new_product_path,
                    class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>