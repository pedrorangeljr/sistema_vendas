<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1>
      <%= @customer.name %>
    </h1>
    <p class="text-muted mb-0">
      Dados do cliente
    </p>
  </div>
  <div>
    <%= link_to "Editar",
                edit_customer_path(@customer),
                class: "btn btn-primary" %>
    <%= link_to "Voltar",
                customers_path,
                class: "btn btn-secondary" %>
  </div>
</div>
<div class="card shadow-sm">
  <div class="card-body">
    <h5 class="mb-3">
      Dados pessoais
    </h5>
    <dl class="row">
      <dt class="col-sm-3">
        Nome
      </dt>
      <dd class="col-sm-9">
        <%= @customer.name %>
      </dd>
      <dt class="col-sm-3">
        CPF
      </dt>
      <dd class="col-sm-9">
        <%= @customer.cpf %>
      </dd>
      <dt class="col-sm-3">
        E-mail
      </dt>
      <dd class="col-sm-9">
        <%= @customer.email || "Não informado" %>
      </dd>
      <dt class="col-sm-3">
        Telefone
      </dt>
      <dd class="col-sm-9">
        <%= @customer.phone || "Não informado" %>
      </dd>
    </dl>
    <hr>
    <h5 class="mb-3">
      Endereço
    </h5>
    <dl class="row">
      <dt class="col-sm-3">
        CEP
      </dt>
      <dd class="col-sm-9">
        <%= @customer.zip_code || "-" %>
      </dd>
      <dt class="col-sm-3">
        Logradouro
      </dt>
      <dd class="col-sm-9">
        <%= [
          @customer.street,
          @customer.number
        ].compact.join(", ").presence || "-" %>
      </dd>
      <dt class="col-sm-3">
        Complemento
      </dt>
      <dd class="col-sm-9">
        <%= @customer.complement || "-" %>
      </dd>
      <dt class="col-sm-3">
        Bairro
      </dt>
      <dd class="col-sm-9">
        <%= @customer.neighborhood || "-" %>
      </dd>
      <dt class="col-sm-3">
        Cidade
      </dt>
      <dd class="col-sm-9">
        <%= @customer.city || "-" %>
      </dd>
      <dt class="col-sm-3">
        Estado
      </dt>
      <dd class="col-sm-9">
        <%= @customer.state || "-" %>
      </dd>
      <dt class="col-sm-3">
        Status
      </dt>
      <dd class="col-sm-9">
        <% if @customer.active? %>
          <span class="badge text-bg-success">
            Ativo
          </span>
        <% else %>
          <span class="badge text-bg-secondary">
            Inativo
          </span>
        <% end %>
      </dd>
    </dl>
  </div>
</div>