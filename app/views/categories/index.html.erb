<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1>Categorias</h1>
    <p class="text-muted">
      Gerenciamento de categorias de produtos
    </p>
  </div>
  <%= link_to "Nova Categoria",
              new_category_path,
              class: "btn btn-primary" %>
</div>
<div class="mb-4">
  <%= form_with url: categories_path,
                method: :get,
                local: true do |form| %>
    <div class="input-group">
      <%= form.text_field :search,
                          value: params[:search],
                          class: "form-control",
                          placeholder: "Pesquisar categoria..." %>
      <%= form.submit "Pesquisar",
                      class: "btn btn-outline-primary" %>
    </div>
  <% end %>
</div>
<div class="card shadow-sm">
  <div class="card-body">
    <% if @categories.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th>Nome</th>
              <th>Descrição</th>
              <th>Status</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @categories.each do |category| %>
              <tr>
                <td>
                  <strong>
                    <%= category.name %>
                  </strong>
                </td>
                <td>
                  <%= category.description %>
                </td>
                <td>
                  <% if category.active? %>
                    <span class="badge text-bg-success">
                      Ativa
                    </span>
                  <% else %>
                    <span class="badge text-bg-secondary">
                      Inativa
                    </span>
                  <% end %>
                </td>
                <td class="text-end">
                  <%= link_to "Visualizar",
                              category_path(category),
                              class: "btn btn-sm btn-outline-primary" %>
                  <%= link_to "Editar",
                              edit_category_path(category),
                              class: "btn btn-sm btn-outline-secondary" %>
                  <%= link_to "Excluir",
                              category_path(category),
                              data: {
                                turbo_method: :delete,
                                turbo_confirm: "Deseja realmente excluir esta categoria?"
                              },
                              class: "btn btn-sm btn-outline-danger" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <h4>Nenhuma categoria cadastrada</h4>
        <p class="text-muted">
          Comece cadastrando a primeira categoria.
        </p>
        <%= link_to "Nova Categoria",
                    new_category_path,
                    class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>