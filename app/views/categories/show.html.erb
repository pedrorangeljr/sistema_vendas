<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1><%= @category.name %></h1>
    <p class="text-muted">
      Detalhes da categoria
    </p>
  </div>
  <div>
    <%= link_to "Editar",
                edit_category_path(@category),
                class: "btn btn-primary" %>
    <%= link_to "Voltar",
                categories_path,
                class: "btn btn-secondary" %>
  </div>
</div>
<div class="card shadow-sm">
  <div class="card-body">
    <dl class="row">
      <dt class="col-sm-3">
        Nome
      </dt>
      <dd class="col-sm-9">
        <%= @category.name %>
      </dd>
      <dt class="col-sm-3">
        Descrição
      </dt>
      <dd class="col-sm-9">
        <%= @category.description.presence || "Não informado" %>
      </dd>
      <dt class="col-sm-3">
        Status
      </dt>
      <dd class="col-sm-9">
        <% if @category.active? %>
          <span class="badge text-bg-success">
            Ativa
          </span>
        <% else %>
          <span class="badge text-bg-secondary">
            Inativa
          </span>
        <% end %>
      </dd>
      <dt class="col-sm-3">
        Criada em
      </dt>
      <dd class="col-sm-9">
        <%= l(@category.created_at, format: :short) %>
      </dd>
    </dl>
  </div>
</div>